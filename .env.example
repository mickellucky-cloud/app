# ==============================================================================
# OKNexus Mobile Exchange - Backend Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Authentication & JWT Security
JWT_SECRET=super-secret-crypto-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d
SESSION_SECRET=oknexus-session-encryption-salt

# AI Intelligence & Grounded Search (Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Relational Database (PostgreSQL / TimescaleDB recommended)
DATABASE_URL=postgresql://oknexus_user:password@localhost:5432/oknexus_exchange?sslmode=prefer

# Redis (Order Matching Engine, Rate Limiter, WebSocket Pub/Sub)
REDIS_URL=redis://default:redispassword@localhost:6379

# Blockchain Node RPC Providers (For Deposit/Withdrawal settlement verification)
TRON_RPC_URL=https://api.trongrid.io
ETH_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Operational Admin & Support
ADMIN_EMAIL=dev@nexus.com
SUPPORT_SLACK_WEBHOOK=
